[Unit]
Description=Home server Compose applications

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=%h/repos/homelab
Environment=PODMAN_COMPOSE_PROVIDER=/usr/bin/podman-compose
ExecStart=/usr/bin/podman compose up -d
ExecStop=/usr/bin/podman compose stop
Restart=on-failure
RestartSec=15s
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=default.target
